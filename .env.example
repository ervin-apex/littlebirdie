NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Stripe sandbox while billing is under development.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_weekly_price
STRIPE_TAX_RATE_ID=txr_your_inclusive_gst_rate

# Keep off until the migration, Stripe resources, and webhook are verified.
BILLING_ENFORCEMENT_ENABLED=false

# Daily email Chirps. Keep the scheduler off until a verified sending domain,
# webhook, and Little Birdee-owned provider credentials are configured.
CHIRP_SCHEDULER_ENABLED=false
RESEND_API_KEY=re_your_server_only_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
CHIRP_CRON_SECRET=generate_a_long_random_value
CHIRP_TOKEN_SECRET=generate_a_different_long_random_value
CHIRP_FROM_EMAIL=Little Birdee <chirps@updates.littlebirdeetoldme.com>
CHIRP_REPLY_TO_EMAIL=help@littlebirdeetoldme.com
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Local development against the Docker stack (recommended)
#
#   npm run db:start     start Postgres, Auth, Studio and a local mail catcher
#   npm run db:reset     re-apply migrations and re-run supabase/seed.sql
#   npm run db:stop      stop the stack
#
# Put the values below in .env.development.local, which Next.js loads ahead of
# .env.local in development. Production builds are unaffected, so you can keep
# your real credentials in .env.local and still develop without touching them.
#
# `npm run db:start` prints the URL and keys to paste in. Leave billing
# enforcement off locally so Stripe is not required.
#
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key printed by db:start>
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key printed by db:start>
#   BILLING_ENFORCEMENT_ENABLED=false
#   CHIRP_SCHEDULER_ENABLED=false
#   APP_BASE_URL=http://localhost:3000
#
# Seeded account: test@littlebirdee.local / password123
# Studio           http://127.0.0.1:54323
# Mail catcher     http://127.0.0.1:54324   (signup and reset emails land here)
