NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Stripe sandbox while billing is under development.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_weekly_price
STRIPE_TAX_RATE_ID=txr_your_inclusive_gst_rate

# Keep off until the migration, Stripe resources, and webhook are verified.
BILLING_ENFORCEMENT_ENABLED=false

# Daily email Chirps. Keep the scheduler off until a verified sending domain,
# webhook, and Little Birdee-owned provider credentials are configured.
CHIRP_SCHEDULER_ENABLED=false
RESEND_API_KEY=re_your_server_only_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
CHIRP_CRON_SECRET=generate_a_long_random_value
CHIRP_TOKEN_SECRET=generate_a_different_long_random_value
CHIRP_FROM_EMAIL=Little Birdee <chirps@updates.your-domain.com>
CHIRP_REPLY_TO_EMAIL=help@your-domain.com
APP_BASE_URL=http://localhost:3000
